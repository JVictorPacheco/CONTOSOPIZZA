}

body:json {
  {
    "nome": "Calabresa",
    "descricao": "Calabresa, cebola e azeitonas",
    "preco": 42.90,
    "tamanho": "Grande"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
